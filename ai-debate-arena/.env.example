# =============================================================================
# AI Debate Arena — variables d'environnement
# Copiez ce fichier en .env.local puis renseignez les clés dont vous avez besoin.
#
# AUCUNE clé n'est obligatoire : sans configuration, l'application démarre en
# MODE DÉMONSTRATION (provider local, aucun appel API, aucun coût). C'est
# suffisant pour parcourir toute l'interface ; les arguments produits sont
# générés à partir de gabarits et n'ont aucune valeur d'analyse.
#
# Renseignez une ou plusieurs clés ci-dessous pour des débats réels. Un
# provider sans clé apparaît simplement comme indisponible dans l'interface.
# =============================================================================

# --- Anthropic (Claude) -----------------------------------------------------
# Console : https://console.anthropic.com/settings/keys
# ATTENTION : un abonnement Claude.ai (Pro/Max) NE donne PAS accès à l'API.
# L'API Anthropic est facturée séparément, à l'usage (voir la console pour les tarifs).
ANTHROPIC_API_KEY=

# Modèle par défaut utilisé si aucun modèle n'est choisi dans l'UI.
# Liste à jour : https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5

# --- Google (Gemini) ---------------------------------------------------------
# Clé obtenue sur Google AI Studio : https://aistudio.google.com/apikey
# ATTENTION : un abonnement Google One / Gemini Advanced NE donne PAS accès à l'API.
# L'API Gemini a un palier gratuit limité, puis une facturation à l'usage au-delà.
GOOGLE_API_KEY=

# Modèle par défaut. Liste à jour : https://ai.google.dev/gemini-api/docs/models
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# --- OpenAI (ChatGPT / GPT) ---------------------------------------------------
# Clé obtenue sur : https://platform.openai.com/api-keys
# ATTENTION : un abonnement ChatGPT Plus/Pro NE donne PAS accès à l'API.
# L'API OpenAI est facturée séparément, à l'usage.
OPENAI_API_KEY=

# Modèle par défaut. Liste à jour : https://platform.openai.com/docs/models
OPENAI_DEFAULT_MODEL=gpt-4o

# --- Paramètres applicatifs (optionnels) -------------------------------------
# Nombre maximum de tours autorisés par débat (garde-fou anti-abus/coûts).
MAX_TURNS_LIMIT=20

# Taille maximale (en caractères) du sujet saisi par l'utilisateur.
MAX_TOPIC_LENGTH=4000

# Timeout par appel provider, en millisecondes. Appliqué à chaque tour ainsi
# qu'à la synthèse ; un tour qui dépasse ce délai est signalé en erreur et le
# débat continue avec les participants suivants.
PROVIDER_TIMEOUT_MS=90000

# --- Garde-fou anti-abus ------------------------------------------------------
# Nombre maximum de débats lançables depuis une même IP par fenêtre, et durée
# de cette fenêtre en millisecondes. Important dès que l'application est
# déployée publiquement : sans cela, n'importe quel visiteur peut consommer
# votre quota API.
# ATTENTION : le compteur vit en mémoire du process. En déploiement
# multi-instance (serverless), chaque instance compte séparément — adossez la
# protection à un store partagé ou au rate limiting de votre plateforme.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# --- Mode démonstration -------------------------------------------------------
# Délai entre deux fragments de texte émis par le provider de démonstration,
# en millisecondes. Baissez-le pour parcourir un débat plus rapidement.
DEMO_TOKEN_DELAY_MS=18
